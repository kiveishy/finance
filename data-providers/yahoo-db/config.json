{
    "version": "0.0.0.7",
    "database": {
        "file_path": "../data/stocks.db"
    },
    "yahoo_finance": {
        "data_interval": "1d",
        "history_period": "1mo",
        "max_retries": 3,
        "retry_delay": 1.0,
        "request_delay": 0.3
    },
    "scheduling": {
        "enabled": true,
        "run_time": "23:30",
        "timezone": "Asia/Jerusalem",
        "catch_up": true
    },
    "files": {
        "nasdaq_tickers": "../data/nasdaq_tickers.json",
        "nyse_tickers": "../data/nyse_tickers.json",
        "nysearca_tickers": "../data/nysearca_tickers.json"
    },
    "web": {
        "host": "0.0.0.0",
        "port": 5000,
        "debug": false
    }
}
